---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Faq from "../../components/Faq.astro";
import content from "../../page-content/landing.html?raw";
import { splitAtFaq } from "../../lib/landing";
import { getAbsoluteLocaleUrl } from "astro:i18n";

const [before, after] = splitAtFaq(content);
---
<SiteLayout
  title="Eccos · open-source WhatsApp gateway"
  description="An open-source WhatsApp gateway on the official Meta Cloud API. Priced per connected number, never per message, coexistence built in. One number or fifty, yours or your clients'. Self-host it, or let us run it."
  canonical={getAbsoluteLocaleUrl("en")}
  landing
>
  <Fragment set:html={before} />
  <Faq locale="en" />
  <Fragment set:html={after} />
</SiteLayout>
