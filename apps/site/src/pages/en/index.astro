---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Faq from "../../components/Faq.astro";
import content from "../../page-content/landing.html?raw";
import { splitAtFaq } from "../../lib/landing";
import { getAbsoluteLocaleUrl } from "astro:i18n";

const [before, after] = splitAtFaq(content);
---
<SiteLayout
  title="Eccos · open-source WhatsApp Business API gateway, priced per number"
  description="An open-source WhatsApp gateway on the official WhatsApp Business API (Meta Cloud API). Flat price per connected number from €5 a month, no per-message fee or markup, coexistence with the WhatsApp Business app built in. Self-host it free, or let us run it."
  canonical={getAbsoluteLocaleUrl("en")}
  landing
>
  <Fragment set:html={before} />
  <Faq locale="en" />
  <Fragment set:html={after} />
</SiteLayout>
