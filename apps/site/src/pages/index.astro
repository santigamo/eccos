---
import SiteLayout from "../layouts/SiteLayout.astro";
import Faq from "../components/Faq.astro";
import content from "../page-content/landing.es.html?raw";
import { splitAtFaq } from "../lib/landing";
import { getAbsoluteLocaleUrl } from "astro:i18n";

const [before, after] = splitAtFaq(content);
---
<SiteLayout
  title="Eccos · gateway de código abierto para la API de WhatsApp Business"
  description="Gateway de WhatsApp de código abierto sobre la API oficial de WhatsApp Business (Cloud API de Meta). Precio fijo por número conectado desde 5 € al mes, sin tarifa ni recargo por mensaje, con coexistencia con la app de WhatsApp Business. Autoalójalo gratis o deja que lo gestionemos por ti."
  canonical={getAbsoluteLocaleUrl("es")}
  landing
>
  <Fragment set:html={before} />
  <Faq locale="es" />
  <Fragment set:html={after} />
</SiteLayout>
