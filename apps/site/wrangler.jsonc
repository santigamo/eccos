{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "eccos-site",
  "compatibility_date": "2026-06-12",

  // Pure static-assets Worker: no `main`, no server code. Everything under
  // public/ is served straight from Cloudflare's edge.
  "assets": {
    "directory": "./public",
    // Serve "/privacy" itself with a 200 (auto-trailing-slash would 307 it to
    // "/privacy/"). These URLs go into Meta's app settings; no redirect hop.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Left on until eccos.chat is on Cloudflare nameservers; the custom domain
  // is added here as a route once the zone is active.
  "workers_dev": true
}
