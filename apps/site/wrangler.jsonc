{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "eccos-site",
  "compatibility_date": "2026-06-12",

  // Pure static-assets Worker: no `main`, no server code. Everything under
  // public/ is served straight from Cloudflare's edge.
  "assets": {
    "directory": "./public",
    // Serve "/privacy" itself with a 200 (auto-trailing-slash would 307 it to
    // "/privacy/"). These URLs go into Meta's app settings; no redirect hop.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Custom domains. `custom_domain: true` makes Cloudflare create and manage the
  // DNS records itself — there is nothing to add by hand in the DNS tab. Both
  // hostnames serve the same site; the canonical <link> in every page points at
  // the apex, so this costs nothing in search.
  "routes": [
    { "pattern": "eccos.chat", "custom_domain": true },
    { "pattern": "www.eccos.chat", "custom_domain": true }
  ],

  // Kept on during setup so there is a URL to test against before DNS settles.
  "workers_dev": true
}
