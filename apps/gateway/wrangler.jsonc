{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "eccos",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-12",

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Custom domain for every Meta-facing origin on this Worker: the webhook
  // callback (`/webhooks/meta`), the Embedded Signup OAuth callback (`/connect`)
  // and the account-scoped `/v1` API. `custom_domain: true` makes Cloudflare
  // create and manage the DNS record itself — nothing to add by hand in the DNS
  // tab. The Meta app declares `eccos.chat` as its application domain, so putting
  // the gateway on the same apex is what makes the app's declared domain and its
  // working endpoints agree for App Review. See docs/deployment.md →
  // "Cutover — moving the Meta-facing origin to a custom domain".
  "routes": [
    { "pattern": "api.eccos.chat", "custom_domain": true }
  ],

  // Deliberately kept on through the cutover: the workers.dev origin stays a
  // working fallback until Meta's callback URL, the Valid OAuth Redirect URIs and
  // GATEWAY_PUBLIC_URL all point at the custom domain. Disabling it is the last,
  // separate step of the runbook — never the same deploy that adds the domain.
  "workers_dev": true,

  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "durable_objects": {
    "bindings": [
      { "name": "ECCOS", "class_name": "EccosGateway" },
      { "name": "CONTROL_PLANE", "class_name": "EccosControlPlane" }
    ]
  },

  // Rate limiting went GA with a top-level "ratelimits" key; the old
  // "unsafe.bindings" form still works but makes every deploy warn about
  // experimental fields. Same namespace_id, so the limiter keeps its state.
  "ratelimits": [
    {
      "name": "SEND_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EccosGateway"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["EccosControlPlane"]
    }
  ],

  "vars": {
    // Wins over the schema default in production: every Graph call and the
    // Embedded Signup dialog are pathed with this. Keep it equal to the version
    // each *subscribed* webhook field carries in the Meta app panel — Meta warns
    // that mixing API versions across one object's fields can delay delivery.
    // All twelve fields subscribed on the WABA object are on v25.0 (verified in
    // the panel on 2026-09-01). Bump procedure: docs/deployment.md#meta-graph-api-version.
    "META_GRAPH_VERSION": "v25.0",
    // Origin the dashboard's Embedded Signup button hands to Meta as
    // `redirect_uri` (`<origin>/connect`). Meta matches it EXACTLY against the
    // app's Valid OAuth Redirect URIs, where `https://api.eccos.chat/connect`
    // was registered on 2026-08-31 before this line was flipped — step 4 then
    // step 5 of the cutover runbook in docs/deployment.md, in that order,
    // because sending an unregistered redirect_uri breaks Embedded Signup for
    // everyone. The workers.dev URIs stay registered as a rollback path until
    // Meta decides the App Review. Direct `POST /connect/start` calls ignore
    // this and derive the origin from the request, so they follow whichever
    // host the browser used.
    "GATEWAY_PUBLIC_URL": "https://api.eccos.chat",
    "FORWARD_MAX_ATTEMPTS": "6",
    // Split retention (docs/data-lifecycle.md). Content window: after these days,
    // inbound_events and outbound_messages rows are deleted, terminal deliveries
    // keep only metadata (payload redacted), and pending deliveries — including
    // events held for want of a forwarding target — are deleted outright.
    // Optional; default 30, clamped to 7-90.
    "CONTENT_RETENTION_DAYS": "30",
    // Delivery-audit window: after these days, terminal (delivered/failed)
    // deliveries rows are deleted entirely. Optional; default 90.
    "DELIVERY_RETENTION_DAYS": "90",
    // EU data residency: the Durable Object is pinned to Cloudflare's EU
    // jurisdiction (docs/deployment.md).
    "DO_JURISDICTION": "eu"
  },

  // Meta platform secrets (META_APP_SECRET, META_WEBHOOK_VERIFY_TOKEN and the
  // optional META_APP_ID / META_ES_CONFIG_ID for Embedded Signup) plus the
  // ECCOS_ADMIN_API_KEY bootstrap secret are set with `wrangler secret put`.
  // ECCOS_ADMIN_API_KEY is for SELF-HOST BOOTSTRAP only (creating the first
  // account and its keys). Normal operation never needs it — connecting a
  // number is done from the console, by Embedded Signup or by pasting a token
  // on Settings — and leaving it unset disables the admin routes outright.
  // Per-tenant WABA credentials and subscriber settings live in the control
  // plane / per-WABA Durable Object state — never in Worker vars.
}
