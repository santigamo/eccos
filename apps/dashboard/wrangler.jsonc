{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "eccos-dashboard",
  // Custom server entry (src/server.ts) — wraps the default TanStack Start fetch
  // handler with the host allowlist and the Better Auth gates. TanStack Start also resolves
  // src/server.ts by convention; pointing `main` here keeps wrangler in sync.
  "main": "src/server.ts",
  "compatibility_date": "2026-06-12",
  "compatibility_flags": ["nodejs_compat"],
  // Preserve installation-specific vars omitted from this template.
  "keep_vars": true,
  // Run next to the auth D1 primary (FRA): every request makes several
  // sequential D1 and gateway calls, so one longer browser hop beats N.
  "placement": { "region": "aws:eu-central-1" },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // workers.dev access is disabled: the workers.dev origin must not be an
  // alternate customer path (contract §6).
  "workers_dev": false,

  // Self-host template: with workers.dev off, the console needs a custom domain
  // here to be reachable at all. Add it, or keep the real values in
  // a gitignored wrangler.production.jsonc (docs/deployment.md#production-config).
  // "routes": [{ "pattern": "console.example.com", "custom_domain": true }],

  // Customer auth is Better Auth only (docs/auth-tenancy-contract.md §6). Set
  // BETTER_AUTH_URL to the console's https origin: the server entry answers
  // only that host (plus localhost in dev) BEFORE routing, so workers.dev and
  // preview origins fail closed. Unset means local development only.
  // Set META_APP_ID / META_ES_CONFIG_ID in production vars or the Cloudflare
  // dashboard to enable the browser SDK. Unset disables it (OAuth still works).
  // Analytics is opt-in via ANALYTICS_SCRIPT_URL / ANALYTICS_WEBSITE_ID, with
  // optional ANALYTICS_DOMAINS. Omit these here to preserve existing values.
  // Set a value to "" explicitly to disable it; omission keeps the remote value.
  // ANALYTICS_EXCLUDE_USER_IDS is a secret, never a var.
  "vars": {
    // Must match the gateway (docs/deployment.md#meta-graph-api-version).
    "META_GRAPH_VERSION": "v25.0"
  },

  // Dedicated auth D1 database (identity plane — docs/auth-tenancy-contract.md §3).
  // Local dev uses the local D1 (`bun run db:migrate:local`), which ignores the
  // placeholder id; put the id from `wrangler d1 create eccos-auth --jurisdiction eu`
  // in your production config. Never shared with gateway message data or other products.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eccos-auth",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Service binding to the gateway Worker (wrangler name "eccos"), reaching its
  // RPC entrypoint `GatewayRPC`. The dashboard resolves the account/WABA scope
  // before every request; the gateway's operator API is never exposed as public HTTP.
  "services": [
    {
      "binding": "GATEWAY",
      "service": "eccos",
      "entrypoint": "GatewayRPC"
    }
  ]
}
