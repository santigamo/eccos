{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "eccos-dashboard",
  // Custom server entry (src/server.ts) — wraps the default TanStack Start fetch
  // handler with the Cloudflare Access JWT gate. TanStack Start also resolves
  // src/server.ts by convention; pointing `main` here keeps wrangler in sync.
  "main": "src/server.ts",
  "compatibility_date": "2026-06-12",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // workers.dev access is disabled: the workers.dev origin must not be an
  // alternate customer path (contract §6).
  "workers_dev": false,

  "routes": [
    { "pattern": "app.eccos.chat", "custom_domain": true }
  ],

  // Customer auth is Better Auth only (docs/auth-tenancy-contract.md §6): the
  // server entry enforces the canonical-host allowlist (app.eccos.chat, plus
  // localhost in dev) BEFORE routing, so the raw workers.dev/preview origins
  // fail closed and are not alternate customer paths.

  // Public, non-secret Meta identifiers the Embedded Signup JavaScript SDK page
  // needs in the browser. They are not credentials — Meta's own implementation
  // guide puts both in client-side JS — but they are per-app values, so they are
  // vars rather than anything committed with a real value here.
  //
  // Leave either EMPTY to disable the SDK path entirely: the Connect button then
  // uses the server-side OAuth redirect to the gateway, which is the flow that
  // has always worked and the only one a self-hoster without a console has.
  // `META_GRAPH_VERSION` must match the gateway's (docs/deployment.md).
  "vars": {
    "META_APP_ID": "1424473183036863",
    "META_ES_CONFIG_ID": "2132668137322605",
    "META_GRAPH_VERSION": "v25.0"
  },

  // Dedicated auth D1 database (identity plane — docs/auth-tenancy-contract.md §3).
  // Per environment: local dev uses the local D1 (`bun run db:migrate:local`); the
  // production/staging database ids are set at the deploy step (eccos-0x0.9) with
  // EU jurisdiction. Never shared with gateway message data or other products.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eccos-auth",
      "database_id": "fcd627f4-9ec7-4f30-afea-e1edaaacde32",
      "migrations_dir": "migrations"
    }
  ],

  // Service binding to the gateway Worker (wrangler name "eccos"), reaching its
  // RPC entrypoint `GatewayRPC`. The dashboard resolves the account/WABA scope
  // before every request; the gateway's operator API is never exposed as public HTTP.
  "services": [
    {
      "binding": "GATEWAY",
      "service": "eccos",
      "entrypoint": "GatewayRPC"
    }
  ]
}
